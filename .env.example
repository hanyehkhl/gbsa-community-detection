# ================================
# GbSA Community Detection — تنظیمات
# این فایل را به .env کپی کنید و مقادیر را ست کنید
# ================================

# --- الگوریتم ---
GBSA_POPULATION_SIZE=20
GBSA_ITERATIONS=50
GBSA_DATASET_PATH=data/karate.gml

# --- LLM (/ OpenAI-compatible) ---
GPT_ENABLED=true
GPT_BASE_URL=https://api.avalai.ir/v1
GPT_API_KEY=
GPT_MODEL=deepseek-v4-flash
#GPT_MODEL=gpt-4o-mini
#GPT_MODEL=gpt-4o
GPT_REQUEST_TIMEOUT=60

# --- Ollama لوکال (به‌جای AvalAI) ---
# در OS env ست کنید:
#   GBSA_LLM_PROVIDER=ollama
#   GBSA_LLM_MODEL=llama3.2
